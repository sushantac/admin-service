<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="03-order-projections" author="admin-service">
        <createTable tableName="order_projections">
            <column name="order_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_number" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_name" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount" type="NUMERIC(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="items_count" type="INT" defaultValueNumeric="0"/>
            <column name="placed_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"/>
        </createTable>

        <createIndex tableName="order_projections" indexName="idx_order_projections_status">
            <column name="status"/>
        </createIndex>

        <createIndex tableName="order_projections" indexName="idx_order_projections_placed_at">
            <column name="placed_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
